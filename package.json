{
  "name": "bluegenes",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Clojure-based GUI for InterMine",
  "scripts": {
    "dev": "clojure -M:dev:cljs:cljs-dev -m bluegenes.dev",
    "watch": "shadow-cljs watch app",
    "compile": "shadow-cljs compile app",
    "build": "clojure -T:build release",
    "less": "lessc --math=always --quiet-deprecations less/site.less resources/public/css/site.css",
    "less:watch": "chokidar \"less/**/*.less\" -c \"npm run --silent less\" --initial",
    "test:unit": "shadow-cljs compile test && node target/test/node-tests.js",
    "test:server": "clojure -M:test-clj",
    "test": "npm run test:e2e",
    "test:e2e": "cypress run",
    "test:smoke": "cypress run --spec cypress/e2e/smoke_cypress_runtime.cy.js",
    "cypress:open": "cypress open --e2e"
  },
  "author": "Joshua Heimbach <joshkh@gmail.com>",
  "license": "SEE LICENSE IN LICENCE",
  "homepage": "https://github.com/intermine/bluegenes#README",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/intermine/bluegenes.git"
  },
  "bugs": {
    "url": "https://github.com/intermine/bluegenes/issues"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "imjs": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-select": "5.10.2",
    "xmldom": "npm:@xmldom/xmldom@0.9.12"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "bootstrap": "^3.3.7",
    "bootstrap-material-design": "git+https://github.com/intermine/bootstrap-material-design.git#im-0.0.2",
    "chokidar-cli": "^2.1.0",
    "cypress": "13.17.0",
    "less": "4.9.1",
    "shadow-cljs": "2.28.18"
  },
  "overrides": {
    "qs": "6.17.1",
    "uuid": "11.1.1",
    "xmldom": "$xmldom"
  }
}
