;; BlueGenes build configuration (replaced project.clj).
;;
;; :deps holds the server (JVM) runtime only: this is what the uberjar and the
;; Clojars pom contain. ClojureScript and the front-end libraries live in the
;; :cljs alias, which shadow-cljs uses (see shadow-cljs.edn :deps).
;; Versions started as those of project.clj at 1.4.5; the libraries have since been
;; bumped (im-7os.2).
;; Build tasks (release, uber, jar, install, deploy): build.clj.
{:paths ["src/clj" "config/defaults" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/core.async {:mvn/version "1.0.567"}
        org.clojure/data.xml {:mvn/version "0.2.0-alpha6"}

        hiccup/hiccup {:mvn/version "1.0.5"}

        ;; HTTP
        clj-http/clj-http {:mvn/version "3.13.1"}
        compojure/compojure {:mvn/version "1.6.2"}
        ring/ring {:mvn/version "1.13.0"}
        cheshire/cheshire {:mvn/version "5.10.0"}
        metosin/ring-http-response {:mvn/version "0.9.5"}
        metosin/muuntaja {:mvn/version "0.6.7"}

        ;; Config
        yogthos/config {:mvn/version "1.1.7"}

        ;; Logging
        com.taoensso/timbre {:mvn/version "6.8.0"}
        com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}

        ;; InterMine libraries used by the server, pinned as git dependencies
        ;; until they are released to Clojars (README, "Sibling libraries").
        ;; build.clj writes them into the pom as the Maven version found in each
        ;; library (VERSION file or build.clj).
        org.intermine/imcljs {:git/url "https://github.com/gmicklem/imcljs.git"
                              :git/sha "98c0f103bbb87812c8f948c7d7478ad349298957"} ; 1.7.0-SNAPSHOT
        org.intermine/bluegenes-tool-store {:git/url "https://github.com/gmicklem/bluegenes-tool-store.git"
                                            :git/sha "4e3e8969cce37966e27af7a7118432d2201d2cac"}} ; 0.3.0-SNAPSHOT, real-path containment + npm package-name validation (400)

 :aliases
 {;; ClojureScript build classpath (shadow-cljs.edn :deps {:aliases [:cljs ...]}).
  ;; The cljsjs.* jars are excluded: shadow-cljs takes React and friends from npm
  ;; (package.json), and src/shim provides the cljsjs.* namespaces that bluegenes
  ;; and im-tables still require (they set the old js/ globals).
  ;; shadow-cljs 2.28 needs Clojure 1.11 or later on its own (build-time) JVM.
  :cljs {:extra-paths ["src/cljs" "src/shim"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                      thheller/shadow-cljs {:mvn/version "2.28.18"}
                      ;; the version shadow-cljs 2.28.18 is built and tested with
                      org.clojure/clojurescript {:mvn/version "1.11.132"}

                      ;; MVC
                      re-frame/re-frame {:mvn/version "1.4.7"}
                      day8.re-frame/async-flow-fx {:mvn/version "0.3.0"}
                      day8.re-frame/forward-events-fx {:mvn/version "0.0.6"}
                      reagent/reagent {:mvn/version "1.2.0"}
                      prismatic/dommy {:mvn/version "1.1.0"}
                      metosin/reitit {:mvn/version "0.7.2"}
                      json-html/json-html {:mvn/version "0.4.7"}
                      markdown-to-hiccup/markdown-to-hiccup {:mvn/version "0.6.2"}

                      ;; HTTP
                      cljs-http/cljs-http {:mvn/version "0.1.49"}

                      ;; Utility libraries
                      com.cognitect/transit-cljs {:mvn/version "0.8.256"}
                      com.andrewmcveigh/cljs-time {:mvn/version "0.5.2"}
                      inflections/inflections {:mvn/version "0.13.2"}
                      binaryage/oops {:mvn/version "0.7.2"}

                      ;; InterMine front-end library (git dependency, see :deps above).
                      ;; It declares no cljsjs jars any more but still requires the
                      ;; cljsjs.* namespaces, which src/shim provides. Its compiled CSS
                      ;; is not in git: bluegenes.prep compiles it from its less/.
                      org.intermine/im-tables {:git/url "https://github.com/gmicklem/im-tables-3.git"
                                               :git/sha "f04d7571495ef5f520f761b678368accd1166d63"}}} ; 0.16.0-SNAPSHOT, React 18 + highlight.js 11 line, nil-safe filter dropdown handlers

  ;; Development-only front-end tooling (dev build preloads).
  :cljs-dev {:extra-deps {binaryage/devtools {:mvn/version "1.0.7"}
                          day8.re-frame/re-frame-10x {:mvn/version "1.12.3"}
                          day8.re-frame/tracing {:mvn/version "0.6.2"}}}

  ;; ClojureScript unit tests (shadow-cljs :test build).
  :test {:extra-paths ["test/cljs"]
         :extra-deps {day8.re-frame/test {:mvn/version "0.1.5"}}}

  ;; Server-side (Clojure) unit tests in test/clj (list the namespaces in
  ;; bluegenes.test-runner):  clojure -M:test-clj
  :test-clj {:extra-paths ["test/clj"]
             :main-opts ["-m" "bluegenes.test-runner"]}

  ;; Development server: config/dev (git-ignored) shadows config/defaults, and
  ;; :development true (read by yogthos/config) enables code reloading.
  ;;   clojure -M:dev:cljs:cljs-dev -m bluegenes.dev   (npm run dev: everything)
  ;;   clojure -M:dev -m bluegenes.core                (only the server)
  :dev {:extra-paths ["dev" "config/dev"]
        :jvm-opts ["-Ddevelopment=true"]}

  ;; Production configuration overrides (git-ignored config/prod).
  ;;   clojure -M:prod -m bluegenes.core   (after clojure -T:build release)
  :prod {:extra-paths ["config/prod"]}

  ;; clojure -M:fmt check | fix   (configuration in .cljfmt.edn)
  :fmt {:deps {dev.weavejester/cljfmt {:mvn/version "0.12.0"}}
        :main-opts ["-m" "cljfmt.main"]}

  ;; clojure -T:build <task>   (tasks: see build.clj)
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  ;; clojure -T:build:deploy deploy   (human release step; drags in the AWS SDK)
  :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}}}}
